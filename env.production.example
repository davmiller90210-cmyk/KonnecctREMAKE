# Copy to .env next to docker-compose.prod.yml and adjust secrets.
# docker compose -f docker-compose.prod.yml --env-file .env up -d

POSTGRES_PASSWORD=change-me-strong-password
APP_SECRET=change-me
MATTERMOST_DB_PASSWORD=change-me

# HTTPS app origin (must match nginx server_name + TLS)
SERVER_URL=https://app.konnecct.com
FRONT_URL=https://app.konnecct.com

# Chat: Mattermost on dedicated host (nginx chat.konnecct.com — required for stable MM10 + iframe)
REACT_APP_CHAT_PROVIDER=mattermost
MATTERMOST_SITE_URL=https://chat.konnecct.com
REACT_APP_MATTERMOST_WEBAPP_URL=https://chat.konnecct.com
# DNS: A record chat.konnecct.com → server IP. TLS: cert must cover chat (e.g. certbot --expand -d app.konnecct.com -d chat.konnecct.com)

# Required for sign-in (without these, the app cannot authenticate).
# Use real keys; do not leave NEXT_PUBLIC_* or REACT_APP_* as empty placeholders — that breaks injection.
# Optional alias: CLERK_PUBLISHABLE_KEY=pk_live_... (compose maps it if NEXT_PUBLIC_* is unset)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Mattermost DB — must match the password used when mattermost-pgdata was first created;
# if unknown, stop mattermost, remove volume konnecctremake_mattermost-pgdata, set a new password here, up again
MATTERMOST_DB_PASSWORD=change-me-mm-db

# STREAM_API_KEY=
# STREAM_API_SECRET=
