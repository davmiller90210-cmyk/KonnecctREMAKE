# Copy to .env next to docker-compose.prod.yml and adjust secrets.
# docker compose -f docker-compose.prod.yml --env-file .env up -d

POSTGRES_PASSWORD=change-me-strong-password
APP_SECRET=change-me
MATTERMOST_DB_PASSWORD=change-me

# HTTPS app origin (must match nginx server_name + TLS)
SERVER_URL=https://app.konnecct.com
FRONT_URL=https://app.konnecct.com

# Chat: Mattermost under app (single origin)
REACT_APP_CHAT_PROVIDER=mattermost
MATTERMOST_SITE_URL=https://app.konnecct.com/_konnecct/mattermost
REACT_APP_MATTERMOST_WEBAPP_URL=https://app.konnecct.com/_konnecct/mattermost

# Clerk / Stream — set your keys
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# REACT_APP_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# STREAM_API_KEY=
# STREAM_API_SECRET=
